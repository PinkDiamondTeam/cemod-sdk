# syntax=docker/dockerfile:1.7
#
# Generic WUPS (Wii U Plugin System) build image, layered on top of a
# project's own ELF `builder` image (infra/docker/Dockerfile) so the wups
# platform build reuses the same devkitPPC/mcwiiu-stdlib toolchain.
#
# The build context MUST be the consuming project's root directory (same
# convention as Dockerfile) so third_party/toolchains/{wut-tools,
# WiiUPluginSystem}/ resolve. BUILDER_IMAGE must name the project's already
#-built ELF builder image (see compose.wups.yaml's `args`).
ARG BASE_IMAGE=ghcr.io/wiiu-env/devkitppc:20260504@sha256:68785e7d75b070b0aea03272b61f36dd2fddfda4f442cdf0e27b168bd36a09fb

FROM ${BASE_IMAGE} AS wut-tools-build
RUN apt-get update \
    && apt-get install -y --no-install-recommends autoconf automake libtool libfreeimage-dev pkg-config zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src/wut-tools
COPY third_party/toolchains/wut-tools/ ./
RUN ./autogen.sh && mkdir build && cd build && ../configure \
    && make -j"$(nproc)" elf2rpl elf2rpl-obfuscater \
    && mkdir -p /artifacts/tools/bin \
    && install -m 0755 elf2rpl-obfuscater /artifacts/tools/bin/elf2rpl-obfuscater

FROM ${BASE_IMAGE} AS wups-build
WORKDIR /src/WiiUPluginSystem
COPY third_party/toolchains/WiiUPluginSystem/ ./
RUN make clean && make -j"$(nproc)" \
    && mkdir -p /artifacts/wups /artifacts/devkitPPC \
    && cp -a lib include share /artifacts/wups/ \
    && cp /opt/devkitpro/devkitPPC/base_rules /opt/devkitpro/devkitPPC/base_tools /artifacts/devkitPPC/

ARG BUILDER_IMAGE
FROM ${BUILDER_IMAGE}
COPY --from=wups-build /artifacts/ /opt/devkitpro/
COPY --from=wut-tools-build /artifacts/ /opt/devkitpro/
RUN test "$(powerpc-eabi-gcc -dumpfullversion)" = "14.2.0" \
    && test -f /opt/devkitpro/mcwiiu-stdlib/.wchar16 \
    && test -f /opt/devkitpro/devkitPPC/base_rules \
    && test -f /opt/devkitpro/wups/share/wups_rules \
    && test -f /opt/devkitpro/wups/lib/libwups.a \
    && test -x /opt/devkitpro/tools/bin/elf2rpl-obfuscater
WORKDIR /project
CMD ["sh", "-c", "sh \"$CEMOD_SDK_ROOT/infra/docker/build-wups.sh\""]
